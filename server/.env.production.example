# ===================================================
# CooLink Backend Production Environment Variables
# Copy to your Render / Railway / Cloud dashboard
# ===================================================

PORT=5000
NODE_ENV=production

# Frontend Production URLs (Comma-separated for multiple origins e.g. Vercel)
CLIENT_URL=https://coolink.vercel.app,https://coolink.app

# Live MongoDB Atlas URI (replace with your Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@coolink.xxxxx.mongodb.net/coolink?retryWrites=true&w=majority

# JWT Secrets (Generate secure 64-char strings)
JWT_ACCESS_SECRET=coolink_production_access_secret_CHANGE_ME_IN_PRODUCTION_KEY_12345
JWT_REFRESH_SECRET=coolink_production_refresh_secret_CHANGE_ME_IN_PRODUCTION_KEY_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Free Email OTP Delivery (Resend / Brevo)
OTP_CHANNEL=EMAIL
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=re_your_free_resend_api_key_here
EMAIL_FROM=CooLink <onboarding@resend.dev>

# Optional SMS Provider for India (if enabling SMS in addition to Email)
SMS_PROVIDER=DEV_LOGGER
FAST2SMS_API_KEY=

# Master Admin Registration Key
ADMIN_SETUP_KEY=coolink_admin_master_setup_secret_2026
