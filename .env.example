# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Use 'in-memory' for zero-setup local dev/testing, or mongodb://localhost:27017/coolink or Atlas URI)
MONGODB_URI=in-memory

# Security & Tokens
JWT_ACCESS_SECRET=coolink_jwt_access_secret_production_ready_key_12345
JWT_REFRESH_SECRET=coolink_jwt_refresh_secret_production_ready_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS & OTP Provider (DEV_LOGGER logs OTP to server console; plug FAST2SMS or TWILIO for production)
SMS_PROVIDER=DEV_LOGGER
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin Master Seeding Key
ADMIN_SETUP_KEY=admin_coolink_secure_setup_2026
